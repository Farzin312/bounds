    given-names: Farzin
    email: farzinshifat@gmail.com
repository-code: "https://github.com/Farzin312/bounds"
url: "https://github.com/Farzin312/bounds"
license: MIT
keywords:
  - architecture
  - tree-sitter
  - static-analysis
  - code-graph
  - ci
